# ==============================================================================
# EMBER MUSIC - Environment Configuration Template
# Copy this file to .env and fill in your private server-side credentials.
# NOTE: .env must NEVER be committed to public git repositories.
# ==============================================================================

# Server Port (Default: 4321)
PORT=4321

# CORS Allowed Origins (Comma-separated list of allowed domains)
ALLOWED_ORIGINS=https://ember-music.vercel.app

# YouTube Data API v3 Key (Server-Side Proxy - Kept secret from browser client)
YOUTUBE_API_KEY=AIzaSyBRrPickOQtOYJUh9bXNzMjIJuBIqZwCpM

# Rate Limiter: Maximum allowed API requests per 60-second window per IP
RATE_LIMIT_MAX=100
